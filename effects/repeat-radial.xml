<?xml version='1.0' encoding='UTF-8' ?>
<effect id="com.alightcreative.effects.repeat.radial" name="Radial Repeat" desc="Dynamically generates multiple copies of the layer, arranged in a circular pattern." category="repeat" tags="repeat" thumb="thumb/repeat-radial.png">

    <!--<strings>-->
        <!--<locale lang="en">-->
            <!--<string name="name">Drawing Progress</string>-->
            <!--<string name="desc">Drawing Progress</string>-->
        <!--</locale>-->
    <!--</strings>-->

    <params>
        <spinner id="count" default="8" min="0" max="150" step="1" label="Count" />
        <spinner id="radius" default="300" min="0" max="2000" step="1" label="Radius" />
        <spinner id="orientation" default="0.0" min="-1800.0" max="1800.0" label="Orientation" ticks="-90,-45,0,45,90" snap="-90,-45,0,45,90" type="angle" step="1" />
        <spinner id="startAngle" default="0.0" min="-36000.0" max="36000.0" label="Angle" ticks="0,45,90,180,270,360" type="angle" step="1" />
        <spinner id="sweep" default="360.0" min="0.0" max="360.0" label="Sweep" ticks="0,45,90,180,270,360" type="angle" step="1" />
        <spinner id="baseScale" default="1.0" min="0" max="10.0" label="Scale" ticks="0.25,0.5,0.75,1,2" step="0.01" />
        <section text="Range Transform" />
        <point id="offset" default="0.0,0.0" label="Offset" />
        <spinner id="angle" default="0.0" min="-1800.0" max="1800.0" label="Angle" ticks="-90,-45,0,45,90" type="angle" step="1" />
        <spinner id="scale" default="1.0" min="0" max="10.0" label="Scale" ticks="0.25,0.5,0.75,1,2" step="0.01" />
        <spinner id="alpha" default="1" min="0" max="1" step="0.001" label="Alpha" />
        <section text="Fill Color" />
        <color id="fillColor" default="#FF2D1EF6" label="Color" alpha="false" />
        <slider id="blend" default="0.00" min="0.0" max="2" ticks="1" snap="1" label="Blend" />
        <switch id="colorAltCopies" default="false" label="Alternate Copies" />

        <section text="Range" />
        <spinner id="start" default="0.0" min="0.0" max="1.0" type="percent" step="0.001" label="Start" ticks="0.0,0.5,1.0" />
        <spinner id="end" default="1.0" min="0.0" max="1.0"  type="percent" step="0.001"  label="End" ticks="0.0,0.5,1.0" />
        <spinner id="phase" default="0.0" min="-1.0" max="2.0" type="percent"  step="0.001" label="Phase" ticks="-1.0,0.0,1.0" />

        <section text="Interpolation &amp; Easing" />
        <slider id="easeIn" default="0" min="-1" max="1" label="Ease In" step="0.01" type="percent" snap="0" ticks="0" />
        <slider id="easeOut" default="0" min="-1" max="1" label="Ease Out" step="0.01" type="percent" snap="0" ticks="0"  />
        <spinner id="overlap" default="0" min="0" max="10" label="Overlap" step="0.01" type="percent" />
        <selector id="shape" default="0" style="radio" label="Shape" >
            <choice label="Ramp" value="0" />
            <choice label="Square" value="1" />
            <choice label="Smooth" value="2" />
            <choice label="Triangle" value="3" />
        </selector>
        <switch id="invert" default="false" label="Invert" />

        <section text="Random Order" />
        <switch id="randomOrder" default="false" label="Random Order" />
        <spinner id="seed" default="0.0" min="0.0" max="5.0" step="0.01" label="Seed" />

        <!--<section text="Time Shift" />-->
        <!--<spinner id="timeShift" default="0" min="0" max="9999" step="0.1" label="Offset" type="seconds" />-->
    </params>

</effect>
